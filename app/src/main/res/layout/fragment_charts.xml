<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_background"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/chartsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sm_surface"
        app:tabIndicatorColor="@color/sm_primary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/sm_primary"
        app:tabTextColor="@color/sm_text_secondary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/chartsPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>