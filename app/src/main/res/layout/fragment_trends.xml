<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="48dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnModeDay"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Day" />

            <Button
                android:id="@+id/btnModeMonth"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Month" />

            <Button
                android:id="@+id/btnModeYear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Year" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTrendPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀" />

            <TextView
                android:id="@+id/tvTrendPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/sm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="2026" />

            <Button
                android:id="@+id/btnTrendNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCategoryChooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_rounded_bg"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="@color/sm_text_primary"
            android:textSize="15sp"
            tools:text="Category: All  ▾" />

        <TextView
            android:id="@+id/tvTrendSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/sm_text_secondary"
            android:textSize="13sp"
            tools:text="Income ₹30000   |   Expense ₹12000" />

        <TextView
            android:id="@+id/tvTrendEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="No data for this period."
            android:textColor="@color/sm_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/trendBarChart"
            android:layout_width="match_parent"
            android:layout_height="320dp" />

    </LinearLayout>

</ScrollView>